# ==========================================
# Stage 1: Build binary
# ==========================================
FROM golang:1.24-bookworm AS builder

WORKDIR /src

# Cache dependencies
COPY backend/go.mod backend/go.sum ./
RUN go mod download

# Copy backend source code
COPY backend/ .

# Build statically linked binary
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /out/api ./cmd/api

# ==========================================
# Stage 2: Runtime runner with CLI tools
# ==========================================
FROM debian:bookworm-slim AS runner

# Install Poppler utilities, Ghostscript & LibreOffice headless for document conversions
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    tzdata \
    poppler-utils \
    ghostscript \
    libreoffice-nogui \
    fonts-dejavu \
    fonts-liberation \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Non-root user for security (UID 10001)
RUN groupadd -g 10001 appgroup && \
    useradd -u 10001 -g appgroup -m -s /bin/sh appuser

WORKDIR /app
COPY --from=builder /out/api /app/api

# Prepare ephemeral storage mount directory
RUN mkdir -p /tmp/convertinaja/jobs && \
    chown -R appuser:appgroup /tmp/convertinaja /app

USER appuser

EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=3s --start-period=2s --retries=3 \
  CMD curl -f http://localhost:8080/health || exit 1

ENTRYPOINT ["/app/api"]
